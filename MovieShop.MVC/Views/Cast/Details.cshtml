@model ApplicationCore.Models.CastDetailsModel

<div class="container mt-4">

    <div class="row mb-4">
        <div class="col-md-3">
            <img src="@Model.ProfilePath" class="img-fluid rounded shadow" />
        </div>

        <div class="col-md-9">
            <h2>@Model.Name</h2>
        </div>
    </div>

    <h4>Movies</h4>
    <ul class="list-group">
        @foreach (var m in Model.Movies)
        {
            <li class="list-group-item d-flex justify-content-between">
                <a href="/Movies/Details/@m.MovieId">@m.Title</a>
                <span class="text-muted">@m.Character</span>
            </li>
        }
    </ul>

</div>