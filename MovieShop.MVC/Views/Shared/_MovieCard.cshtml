@model ApplicationCore.Models.MovieCardModel

<div class="card h-100 shadow-sm">
    <img src="@Model.PosterUrl" class="card-img-top" alt="@Model.Title" />

    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text text-muted">$@Model.Price</p>
        <a href="/Movies/Details/@Model.Id" class="btn btn-primary w-100">View Details</a>
    </div>
</div>